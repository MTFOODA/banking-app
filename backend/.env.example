# Local development environment for the Faisal App backend.
# Copy this file to backend/.env and adjust. NEVER commit real credentials.
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://faisal:faisal@localhost:5432/faisal_bank
TEST_DATABASE_URL=postgresql+psycopg://faisal:faisal@localhost:5432/faisal_bank_test

JWT_SECRET=dev-only-faisal-app-jwt-secret-change-before-any-real-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
FIRST_LOGIN_TOKEN_MINUTES=10
LOGIN_IDENTIFIER_PEPPER=dev-only-faisal-app-pepper-change-me

CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:5173

UPLOAD_DIR=var/uploads
MAX_UPLOAD_BYTES=5242880

# Demo administrator bootstrap values used by `python -m app.cli bootstrap-admin`.
# These are local-only values; the administrator must change the temporary password at first login.
DEMO_ADMIN_EMPLOYEE_NUMBER=EMP-10001
# Leave empty to use the secure interactive CLI prompt.
DEMO_ADMIN_INITIAL_PASSWORD=
DEMO_ADMIN_NAME=Demo Administrator

# Demo customers are created by `python database/seed_demo.py` (idempotent).

# Registration: development adapter sends no email/SMS. Never enable code
# exposure outside development/test. SMTP always requires STARTTLS.
OTP_PROVIDER=development
OTP_DEV_EXPOSE=false
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
AUTHORIZATION_TTL_SECONDS=180
TRANSFER_LIMIT=100000
# disabled by default; development is permitted only in development/test.
# This adapter never contacts a bank, wallet, SWIFT or InstaPay network.
OUTBOUND_TRANSFER_PROVIDER=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Fictional investments: applied only when new catalogue entries are initialized.
INVESTMENT_MAX_PENALTY_PERCENT=5
# Global indicative FX. Free/keyless feed may be delayed 900 seconds.
# Keep a paid provider key on the backend only. Never commit a real key.
FX_API_KEY=
FX_CACHE_SECONDS=60
# Total synthetic bid/ask spread (100 bps = 1%); not a bank dealing quote.
FX_SPREAD_BPS=100

# Own-account simulated FX quote validity; 30..600 seconds.
OWN_FX_QUOTE_SECONDS=180
