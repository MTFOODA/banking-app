<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen: the same original logo artwork as the
         Flutter UI and the launcher icon, centred on the artwork's white
         background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
